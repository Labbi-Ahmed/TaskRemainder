{
  "manifest_version": 3,
  "name": "TaskReminder",
  "version": "1.0",
  "description": "Smart Content Reminder App",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open TaskReminder"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": [
    "storage"
  ]
}
